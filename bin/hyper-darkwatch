#!/bin/sh
# Start hyperiond when KDE color scheme turns dark (e.g. at sunset via Plasma auto switching); stop it on light.
while :; do
  scheme=$(kreadconfig6 --group General --key ColorScheme)
  case "$scheme" in
    *[Dd]ark*) pgrep -x hyperiond >/dev/null || setsid "$HOME/.local/bin/hyperiond" >/dev/null 2>&1 & ;;
    *) pkill -x hyperiond ;;
  esac
  sleep 1
done
